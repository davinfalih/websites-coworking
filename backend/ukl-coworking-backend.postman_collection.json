              "raw": "{\n  \"harga_per_jam\": 17500,\n  \"deskripsi\": \"Meja kerja pribadi dekat jendela (updated)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "[ADMIN_SPACE] Update sebagian field space."
          },
          "response": []
