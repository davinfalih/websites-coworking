{
  "info": {
    "name": "Smart Space Booking API (UKL Backend)",
    "description": "Postman collection untuk testing API backend Smart Space Booking (NestJS + Prisma + MariaDB).\\n\\nLangkah pakai:\\n1. Pilih environment / gunakan variable bawaan (host = http://localhost:3000).\\n2. Jalankan folder 'Auth' -> login Admin & Member agar token tersimpan otomatis.\\n3. Request lain yang butuh akses memakai header Authorization: Bearer {{owner_token}} / {{member_token}}.\\n\\nAkun test: noda owner1/password123 (ADMIN_SPACE), member1/password123 (MEMBER).\\nStatus reservasi: BELUM_DIKONFIRM, DISETUJUI, AKTIF, SELESAI, DIBATALKAN.\\nTipe space: DESK, MEETING_ROOM, PRIVATE_OFFICE.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "host", "value": "http://localhost:3000", "type": "string" },
    { "key": "owner_token", "value": "", "type": "string" },
    { "key": "member_token", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Member",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{host}}/auth/register/member", "host": ["{{host}}"], "path": ["auth", "register", "member"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"member2\",\n  \"password\": \"password123\",\n  \"nama_member\": \"Nadia Putri\",\n  \"instansi\": \"PT Kreatif Nusantara\",\n  \"alamat\": \"Jakarta\",\n  \"telp\": \"081234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Registrasi akun member/pengunjung. username harus unik."
          },
          "response": []
        },
        {
          "name": "Register Owner (ADMIN_SPACE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{host}}/auth/register/owner", "host": ["{{host}}"], "path": ["auth", "register", "owner"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"owner2\",\n  \"password\": \"password123\",\n  \"nama_coworking\": \"Space Kreatif Jakarta\",\n  \"nama_pemilik\": \"Dewi Anggraini\",\n  \"telp\": \"081298765432\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Registrasi pengelola space (role ADMIN_SPACE)."
          },
          "response": []
        },
        {
          "name": "Login Owner (simpan token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{host}}/auth/login", "host": ["{{host}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"owner1\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login sebagai ADMIN_SPACE. Token otomatis disimpan ke variabel owner_token.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "const d = pm.response.json();",
                    "pm.test('Login owner sukses', () => pm.expect(pm.response.code).to.eql(200));",
                    "if (d && d.data && d.data.access_token) {",
                    "  const role = (d.data.user && d.data.user.role) || d.data.role;",
                    "  if (role === 'ADMIN_SPACE') pm.collectionVariables.set('owner_token', d.data.access_token);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        },
        {
          "name": "Login Member (simpan token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{host}}/auth/login", "host": ["{{host}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"member1\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Login sebagai MEMBER. Token otomatis disimpan ke variabel member_token.",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "const d = pm.response.json();",
                    "pm.test('Login member sukses', () => pm.expect(pm.response.code).to.eql(200));",
                    "if (d && d.data && d.data.access_token) {",
                    "  const role = (d.data.user && d.data.user.role) || d.data.role;",
                    "  if (role === 'MEMBER') pm.collectionVariables.set('member_token', d.data.access_token);",
                    "}"
                  ],
                  "type": "text/javascript"
                }
              }
            ]
          },
          "response": []
        }
      ]
    },
