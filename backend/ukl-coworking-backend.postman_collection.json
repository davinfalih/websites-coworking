        {
          "name": "Hapus space (owner)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{owner_token}}" }],
            "url": { "raw": "{{host}}/spaces/1", "host": ["{{host}}"], "path": ["spaces", "1"] },
            "description": "[ADMIN_SPACE] Hapus space berdasarkan ID."
          },
          "response": []
        }
      ]
